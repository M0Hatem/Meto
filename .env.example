# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
# Optional secondary user account token (self-bot) for voice channel persistence and /stream feature
# (Extract with token-extractor/ tool)
DISCORD_TOKEN_SECONDARY=your_user_token_here

# Optional tertiary bot token (standard Bot account) specifically for /bc broadcast command
DISCORD_TOKEN_TERTIARY=your_tertiary_bot_token_here

# Maximum file size in MB that the bot can upload to Discord.
# Default Discord limit for non-boosted servers is 10MB or 25MB depending on standard limits.
# Nitro / Boosted servers can go up to 50MB, 100MB, or 500MB.
MAX_FILE_SIZE_MB=25

# Path to the file containing whitelisted Discord server IDs (can be a JSON array or a text file with one ID per line).
# Leave commented or empty to allow all servers.
ALLOWED_SERVERS_FILE=allowed_servers.json

# Optional: custom ffmpeg path (if not on system PATH)
FFMPEG_PATH=

# Groq API Key for AI Chat functionality (get from https://console.groq.com/keys)
GROQ_API_KEY=
